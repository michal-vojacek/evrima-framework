# Local development settings. Copy to .env; never commit the real .env.
EVRIMA_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite is accepted outside production; production requires PostgreSQL.
DATABASE_URL=sqlite:///minimal.sqlite3

# The website's host names, comma-separated (required in production). Links in
# e-mails are built only for these hosts; requests for other hosts get 400.
# SITE_HOSTS=example.com,www.example.com

# memory:// keeps rate limits in the process; production requires Redis.
REDIS_URL=memory://

# E-mail. Outside production MAIL_BACKEND defaults to "console" (messages are
# written to the log, handy for reading a password reset link). Production needs smtp:
# MAIL_BACKEND=smtp
# SMTP_HOST=smtp.seznam.cz
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=web@example.com
# SMTP_PASSWORD=
# MAIL_SENDER=web@example.com

# Telemetry: empty endpoint = off. The token comes from the telemetry collector.
# TELEMETRY_ENDPOINT=https://telemetry.example.com
# TELEMETRY_TOKEN=
